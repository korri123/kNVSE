<!-- A page tab of kNVSE's menu (knvse_menu.xml): _active on the page shown -->
<locus> &true; </locus>
<target> &true; </target>
<clicksound> UIMenuPrevNext </clicksound>
<_active> 0 </_active>
<y> 50 </y>
<width> 150 </width>
<height> 34 </height>

<image name="Fill">
	<filename> solid.dds </filename>
	<texatlas> Interface\InterfaceShared.tai </texatlas>
	<systemcolor> &hudmain; </systemcolor>
	<width> <copy src="parent()" trait="width"/> </width>
	<height> <copy src="parent()" trait="height"/> </height>
	<alpha>
		<copy src="parent()" trait="_active"/> <mul> 60 </mul>
		<add> <copy src="parent()" trait="mouseover"/> <mul> 25 </mul> </add>
	</alpha>
</image>

<text name="Label">
	<systemcolor> &hudmain; </systemcolor>
	<font> 3 </font>
	<justify> &center; </justify>
	<x> <copy src="parent()" trait="width"/> <div> 2 </div> </x>
	<y> 4 </y>
</text>
